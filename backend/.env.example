# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=bookleaf

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
AUTH_COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# Choose strong initial passwords and distribute them securely.
SEED_AUTHOR_PASSWORD=replace-with-a-strong-author-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Google AI Studio Gemini (server-side only)
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
